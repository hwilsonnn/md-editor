{
	"name": "md-editor",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"lint": "eslint .",
		"package": "electron-builder"
	},
	"dependencies": {
		"electron-store": "^10.0.0",
		"prism-react-editor": "^1.1.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-markdown": "^9.0.1",
		"remark-gfm": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.11.1",
		"@types/react": "^18.3.10",
		"@types/react-dom": "^18.3.0",
		"@vitejs/plugin-react": "^4.3.2",
		"electron": "^33.0.0",
		"electron-builder": "^25.1.8",
		"electron-vite": "^2.3.0",
		"eslint": "^9.11.1",
		"eslint-plugin-react-hooks": "^5.1.0-rc.0",
		"eslint-plugin-react-refresh": "^0.4.12",
		"globals": "^15.9.0",
		"typescript": "^5.5.3",
		"typescript-eslint": "^8.7.0",
		"vite": "^5.4.8"
	},
	"build": {
		"appId": "com.mdeditor.app",
		"productName": "Markdown Editor",
		"files": [
			"out/**/*"
		],
		"win": {
			"target": "nsis",
			"icon": "public/markdown.svg"
		},
		"mac": {
			"target": "dmg"
		},
		"linux": {
			"target": "AppImage"
		}
	}
}
